{
	"name": "eventful",
	"version": "1.0.0",
	"description": "Eventful - Your passport to unforgettable moments",
	"main": "dist/server.js",
	"scripts": {
		"dev": "ts-node-dev --respawn --transpile-only src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"test": "jest --coverage",
		"test:watch": "jest --watch",
		"test:integration": "jest --testPathPattern=integration",
		"lint": "eslint . --ext .ts",
		"lint:fix": "eslint . --ext .ts --fix",
		"migrate": "psql -d eventful -f migrations/001_initial_schema.sql",
		"seed": "ts-node-dev src/scripts/seed.ts"
	},
	"keywords": [
		"events",
		"ticketing",
		"nodejs",
		"typescript",
		"paystack"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"express": "^4.18.2",
		"bcryptjs": "^2.4.3",
		"jsonwebtoken": "^9.0.2",
		"pg": "^8.11.3",
		"pg-promise": "^11.5.4",
		"redis": "^4.6.10",
		"qrcode": "^1.5.3",
		"axios": "^1.6.2",
		"nodemailer": "^6.9.7",
		"node-cron": "^3.0.3",
		"express-rate-limit": "^7.1.5",
		"express-validator": "^7.0.1",
		"helmet": "^7.1.0",
		"cors": "^2.8.5",
		"dotenv": "^16.3.1",
		"winston": "^3.11.0",
		"morgan": "^1.10.0",
		"uuid": "^9.0.1",
		"date-fns": "^2.30.0",
		"swagger-ui-express": "^5.0.0",
		"yamljs": "^0.3.0"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^20.10.6",
		"@types/bcryptjs": "^2.4.6",
		"@types/jsonwebtoken": "^9.0.5",
		"@types/qrcode": "^1.5.5",
		"@types/nodemailer": "^6.4.14",
		"@types/node-cron": "^3.0.11",
		"@types/cors": "^2.8.17",
		"@types/morgan": "^1.9.9",
		"@types/uuid": "^9.0.7",
		"@types/swagger-ui-express": "^4.1.6",
		"@types/yamljs": "^0.2.34",
		"@types/jest": "^29.5.11",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "^6.16.0",
		"@typescript-eslint/parser": "^6.16.0",
		"eslint": "^8.56.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.1",
		"supertest": "^6.3.3",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.3.3",
		"node-pg-migrate": "^6.2.2"
	}
}
