# Render Environment Variables Template
# Copy these to your Render service dashboard

# Application (Auto-configured by Render)
NODE_ENV=production
PORT=3000

# Database (Auto-configured when using render.yaml)
# Use Internal Database URL from Render dashboard
DATABASE_URL=postgresql://user:password@hostname:5432/eventful

# Redis (Auto-configured when using render.yaml)
# Use Internal Redis URL from Render dashboard
REDIS_URL=redis://hostname:6379

# JWT Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
# Or let Render auto-generate by setting generateValue: true in render.yaml
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRES_IN=30d

# Paystack Configuration
# Get your keys from https://dashboard.paystack.com/#/settings/developer
# Use test keys (sk_test_...) for testing or live keys (sk_live_...) for production
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
# Replace 'your-app-name' with your actual Render app name
PAYSTACK_CALLBACK_URL=https://your-app-name.onrender.com/api/v1/payments/callback

# Email Configuration (SMTP)
# For Gmail:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=noreply@eventful.com

# Frontend Configuration
# Replace with your actual frontend URL
# If deploying frontend to Render: https://your-frontend-app.onrender.com
# If using Vercel/Netlify: https://your-app.vercel.app
FRONTEND_URL=https://your-frontend-url.com
